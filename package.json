{
  "name": "ashen-reach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/game/engine/__tests__ src/game/rules/__tests__ src/server/__tests__ src/client",
    "test:client": "vitest run src/client",
    "test:phone-matrix": "tsx scripts/validate-phone-device-matrix.ts",
    "test:e2e:scenarios": "tsx scripts/validate-six-scenario-e2e.ts",
    "test:engine": "vitest run src/game/engine/__tests__ src/game/rules/__tests__",
    "test:rules": "vitest run src/game/rules/__tests__",
    "test:integration": "vitest run src/server/__tests__",
    "validate:content": "tsx scripts/validate-content.ts",
    "analyze:play-feel": "tsx scripts/analyze-play-feel.ts",
    "analyze:economy": "tsx scripts/analyze-economy.ts",
    "audit:topology": "tsx scripts/generate-board-transition-manifest.ts",
    "test:topology": "vitest run src/game/rules/__tests__/boardTopologyProgression.test.ts src/game/engine/__tests__/boardSpaceRules.test.ts src/server/__tests__/sessionState.test.ts src/client/tv/__tests__/BoardMap.test.tsx src/client/phone/__tests__/PhoneActionPanel.test.tsx",
    "calibrate:economy": "tsx scripts/calibrate-economy.ts",
    "test:economy-calibration": "vitest run scripts/__tests__/economy-calibration.test.ts",
    "qa:economy": "tsx scripts/capture-economy-qa.ts",
    "qa:map-progression": "tsx scripts/capture-map-progression-qa.ts",
    "qa:host-ui": "tsx scripts/capture-host-ui-qa.ts",
    "qa:host-ui:rare": "tsx scripts/capture-host-ui-rare-states.ts",
    "qa:mid-game-join": "tsx scripts/capture-mid-game-join-qa.ts",
    "audit:assets": "tsx scripts/audit-assets.ts",
    "audit:assets:release": "tsx scripts/audit-assets.ts --release",
    "generate:card-images:gemini": "npm run export:image-prompts && tsx scripts/generate-card-images-gemini.ts",
    "generate:card-images:openai": "npm run export:image-prompts && tsx scripts/generate-card-images-openai.ts",
    "export:image-prompts": "tsx scripts/export-image-prompts.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.5",
    "vitest": "^3.2.4"
  }
}
