+  box-shadow: 0 1.2rem 4rem rgba(0, 0, 0, 0.75);
+}
+
+.phone-card-inspect__panel > header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.75rem;
+  padding: 0.75rem;
+  border-bottom: 1px solid rgba(209, 174, 99, 0.25);
+}
+
+.phone-card-inspect__panel h2,
+.phone-card-inspect__panel header span,
+.phone-card-inspect__copy p {
+  margin: 0;
+}
+
+.phone-card-inspect__panel header span {
+  color: #b99a5e;
+  font-size: 0.68rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+.phone-card-inspect__panel h2 {
+  color: #f0e4c8;
+  font-size: 1.05rem;
+}
+
+.phone-card-inspect__close {
+  min-height: 2.75rem;
+  padding: 0.55rem 0.8rem;
+  border: 1px solid rgba(209, 174, 99, 0.55);
+  background: rgba(35, 25, 16, 0.86);
+  color: #f0e4c8;
+}
+
+.phone-card-inspect__art-frame {
+  min-height: 0;
+  padding: 0.65rem;
+  background: radial-gradient(
+    circle at center,
+    rgba(45, 60, 62, 0.35),
+    rgba(0, 0, 0, 0.72)
+  );
+}
+
+.phone-card-inspect__art-frame img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+}
+
+.phone-card-inspect__copy {
+  display: grid;
+  gap: 0.45rem;
+  max-height: 30dvh;
+  overflow-y: auto;
+  padding: 0.75rem;
+  border-top: 1px solid rgba(209, 174, 99, 0.25);
+}
+
+.phone-card-inspect__lore {
+  color: #d8c8a4;
+  font-style: italic;
+}
+
+.phone-card-inspect__rules {
+  color: #f2eee3;
+  line-height: 1.45;
+}
+
+@media (max-width: 420px) {
+  .phone-card-inspect__panel {
+    height: calc(
+      100dvh - 1.5rem - env(safe-area-inset-top) - env(safe-area-inset-bottom)
+    );
+  }
 }
