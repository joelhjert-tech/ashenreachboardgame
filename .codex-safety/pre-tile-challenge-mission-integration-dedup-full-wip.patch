+/* Ashengate approved hybrid: Ash War Table + Cinder Instrument */
+:root {
+  --ag-iron-950: #07090a;
+  --ag-iron-900: #0d1113;
+  --ag-iron-800: #151b1e;
+  --ag-iron-700: #222a2d;
+  --ag-bone-100: #d8d0bd;
+  --ag-bone-200: #bcb29d;
+  --ag-bone-300: #948975;
+  --ag-brass: #a88852;
+  --ag-brass-bright: #d0b377;
+  --ag-signal: #76a9c9;
+  --ag-danger: #a74f42;
+  --ag-ready: #7d9b78;
+  --ag-rule: rgba(190, 169, 126, .28);
+  --ag-rule-strong: rgba(208, 179, 119, .58);
+  --ag-touch: 44px;
+  --ag-fast: 140ms;
+  --ag-normal: 240ms;
+  --ag-slow: 420ms;
+}
+
+@keyframes ag-instrument-enter {
+  from { opacity: 0; transform: translateX(12px); }
+  to { opacity: 1; transform: translateX(0); }
+}
+
+@keyframes ag-status-turn {
+  to { transform: rotate(1turn); }
+}
+
+/* Host: persistent war table */
+.tv-command-dashboard {
+  background:
+    linear-gradient(90deg, rgba(168,136,82,.035) 1px, transparent 1px) 0 0 / 96px 100%,
+    radial-gradient(circle at 50% 40%, #171d1f 0, #090c0e 68%);
+}
+
+.tv-command-header,
+.tv-host-bottom-strip,
+.tv-command-sidebar,
+.tv-operatives-rail {
+  background: linear-gradient(180deg, rgba(25,30,31,.98), rgba(8,11,12,.98));
+  border-color: var(--ag-rule-strong);
+  box-shadow: inset 0 1px rgba(255,255,255,.035);
+}
+
+.tv-command-header-chip,
+.tv-card,
+.tv-sidebar-card,
+.tv-operative-card {
+  border-radius: 2px;
+  border-color: var(--ag-rule);
+  box-shadow: none;
+}
+
+.tv-command-main {
+  gap: clamp(8px, .8vw, 14px);
+}
+
+.tv-command-stage {
+  isolation: isolate;
+  background: var(--ag-iron-950);
+  border: 1px solid var(--ag-rule-strong);
+  box-shadow: 0 12px 32px rgba(0,0,0,.38), inset 0 0 0 3px rgba(0,0,0,.35);
+}
+
+.tv-command-map-shell {
+  min-width: 0;
+  min-height: 0;
+}
+
+.tv-command-stage-battle-mode {
+  display: grid;
+  grid-template-columns: minmax(44%, .92fr) minmax(52%, 1.08fr);
+  gap: 10px;
+  padding: 10px;
+}
+
+.tv-command-map-shell--battle-context {
+  position: relative;
+  overflow: hidden;
+  border: 1px solid var(--ag-rule-strong);
+  filter: saturate(.72) brightness(.72);
+}
+
+.tv-command-map-shell--battle-context::after {
+  content: "Battle location";
+  position: absolute;
+  inset: 14px auto auto 14px;
+  padding: 7px 11px;
+  color: var(--ag-bone-100);
+  background: rgba(7,9,10,.86);
+  border-left: 3px solid var(--ag-danger);
+  font: 700 12px/1.2 system-ui, sans-serif;
+  letter-spacing: .14em;
+  text-transform: uppercase;
+}
+
+.tv-command-battle-instrument {
+  min-width: 0;
+  min-height: 0;
+  overflow: hidden;
+  border: 1px solid var(--ag-rule-strong);
+  background: var(--ag-iron-900);
+  animation: ag-instrument-enter var(--ag-normal) ease-out both;
+}
+
+.tv-command-battle-instrument .host-battle-overlay {
+  position: relative;
+  inset: auto;
+  width: 100%;
+  height: 100%;
+  padding: 0;
+  background: transparent;
+  backdrop-filter: none;
+}
+
+.tv-command-battle-instrument .host-battle-panel {
+  width: 100%;
+  height: 100%;
+  max-width: none;
+  border: 0;
+  border-radius: 0;
+}
+
+.tv-host-context-battle {
+  position: relative;
+  overflow: visible;
+  border-left: 2px solid var(--ag-brass);
+}
+
+.tv-host-context-battle::before {
+  content: "";
+  position: absolute;
+  top: 42px;
+  right: 100%;
+  width: clamp(26px, 3vw, 58px);
+  border-top: 1px solid var(--ag-brass-bright);
+  box-shadow: 0 0 8px rgba(208,179,119,.24);
+}
+
+.tv-host-context-kicker,
+.tv-panel-title,
+.phone-sheet-section-heading,
+.phone-panel-kicker {
+  letter-spacing: .13em;
+  text-transform: uppercase;
+}
+
+.talisman-board-tile-active,
+.talisman-board-tile-selected,
+.board-node-active {
+  outline: 2px solid var(--ag-brass-bright);
+  outline-offset: 2px;
+}
+
+.board-route-movement,
+.talisman-board-travel-route {
+  filter: drop-shadow(0 0 4px rgba(208,179,119,.65));
+}
+
+.tv-button,
+.phone-button,
+.game-button {
+  min-height: var(--ag-touch);
+}
+
+.tv-button:focus-visible,
+.phone-button:focus-visible,
+.game-button:focus-visible,
+.phone-portrait-tab:focus-visible,
+.phone-inventory-group-toggle:focus-visible {
+  outline: 3px solid var(--ag-brass-bright);
+  outline-offset: 3px;
+}
+
+/* Phone: private cinder instrument */
+.phone-page,
+.phone-portrait-controller {
+  background:
+    linear-gradient(180deg, rgba(255,255,255,.018), transparent 18%),
+    #080b0d;
+}
+
+.phone-portrait-panel {
+  background: linear-gradient(180deg, #121719, #090c0e);
+  border-color: var(--ag-rule-strong);
+}
+
+.phone-portrait-topbar,
+.phone-compact-status-strip {
+  background: linear-gradient(180deg, #1b2021, #0f1315);
+  border-bottom: 1px solid var(--ag-rule-strong);
+}
+
+.phone-portrait-scroll {
+  min-height: 0;
+  scrollbar-color: var(--ag-brass) transparent;
+}
+
+.phone-portrait-screen {
+  color: var(--ag-bone-100);
+}
+
+.phone-portrait-section,
+.phone-portrait-hero-card,
+.phone-portrait-info-card {
+  background: transparent;
+  border-radius: 2px;
+  border-color: var(--ag-rule);
+  box-shadow: none;
+}
+
+.phone-portrait-section {
+  padding-inline: 0;
+}
+
+.phone-sheet-section-heading {
+  color: var(--ag-brass-bright);
+  border-bottom: 1px solid var(--ag-rule);
+}
+
+.phone-stat-card {
+  background: linear-gradient(100deg, rgba(216,208,189,.07), rgba(216,208,189,.025));
+  border-color: var(--ag-rule);
+}
+
+.phone-inventory-panel {
+  display: grid;
+  gap: 12px;
+}
+
+.phone-inventory-timing-groups {
+  order: -3;
+}
+
+.phone-inventory-group {
+  margin: 0;
+  border: 0;
+  border-top: 1px solid var(--ag-rule);
+  background: transparent;
+}
+
+.phone-inventory-group-toggle {
+  min-height: var(--ag-touch);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  cursor: pointer;
+  list-style: none;
+  padding: 10px 4px;
+}
+
+.phone-inventory-group-toggle::after {
+  content: "+";
+  color: var(--ag-brass-bright);
+  font: 700 20px/1 system-ui, sans-serif;
+}
+.phone-inventory-group.is-open .phone-inventory-group-toggle::after { content: "−"; }
+
+.phone-inventory-card-list {
+  gap: 0;
+}
+
+.phone-inventory-card {
+  border: 0;
+  border-bottom: 1px solid var(--ag-rule);
+  border-radius: 0;
+  background: linear-gradient(90deg, rgba(216,208,189,.055), transparent 75%);
+  box-shadow: none;
+}
+
+.phone-inventory-card-useful-now,
+.phone-inventory-card-usable-now {
+  background: linear-gradient(90deg, rgba(125,155,120,.16), rgba(125,155,120,.03));
+  border-left: 3px solid var(--ag-ready);
+}
+
+.phone-inventory-card-exhausted,
+.phone-inventory-card-locked,
+.phone-inventory-card-not-usable-now {
+  opacity: .76;
+}
+
+.phone-inventory-card-status,
+.phone-inventory-card-meta,
+.phone-inventory-stat-bonus {
+  font-family: system-ui, sans-serif;
+  letter-spacing: .045em;
+}
+
+.phone-bottomdock,
+.phone-portrait-tabs,
+.phone-compact-tab-dock {
+  background: linear-gradient(180deg, #151a1c, #080b0d);
+  border-top: 1px solid var(--ag-rule-strong);
+  padding-bottom: max(8px, env(safe-area-inset-bottom));
+}
+
+.phone-portrait-tab {
+  min-height: var(--ag-touch);
+  border-radius: 0;
+}
+
+.phone-portrait-tab-active {
+  color: var(--ag-brass-bright);
+  box-shadow: inset 0 3px var(--ag-brass-bright);
+}
+
+/* Shared semantic states, expressed without color dependence. */
+.phone-muted-copy[aria-busy="true"],
