+.tv-movement-journey__tile-image { width:100%; height:100%; object-fit:cover; object-position:center; }
+.tv-movement-journey__tile-art > span { position:absolute; top:.4rem; left:.4rem; padding:.22rem .4rem; background:rgba(5,7,8,.82); border:1px solid rgba(201,158,83,.42); }
+.tv-movement-journey__route li span { color:var(--ag-bone-100); font-size:.7rem; letter-spacing:.1em; text-transform:uppercase; }
