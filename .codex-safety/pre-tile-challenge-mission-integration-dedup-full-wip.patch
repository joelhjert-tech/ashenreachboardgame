+  inset: 0;
+  padding: clamp(0.25rem, 0.55vw, 0.65rem);
+}
+
+.tv-dedicated-battle-stage .host-battle-panel {
+  width: 100%;
+  height: 100%;
+  max-width: 104rem;
+}
+
+@media (max-width: 1300px), (max-height: 760px) {
+  .tv-dedicated-battle-stage { padding: 0.35rem; gap: 0.35rem; }
+  .tv-dedicated-battle-context { min-height: 2.15rem; padding-block: 0.25rem; }
