+  .tv-dedicated-battle-stage .host-battle-vs-block > strong { font-size: clamp(2.25rem, 4.4vw, 3.8rem); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tv-dedicated-battle-stage {
+    animation-name: ag-instrument-enter;
+    clip-path: none;
+  }
+}
