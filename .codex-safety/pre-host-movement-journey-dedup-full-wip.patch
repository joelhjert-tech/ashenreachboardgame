+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  border: 1px solid var(--ag-rule-strong);
+  box-shadow: inset 0 0 0 3px rgba(0, 0, 0, 0.38), inset 0 0 5rem rgba(0, 0, 0, 0.28);
+}
+
+@keyframes ag-battle-chamber-enter {
