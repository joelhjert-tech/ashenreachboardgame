+  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
+  align-items: center;
+  gap: 0.8rem;
+  padding: 0.42rem clamp(0.7rem, 1.2vw, 1.25rem);
+  border-block: 1px solid var(--ag-rule);
+  color: var(--ag-bone-200);
+  background: linear-gradient(90deg, rgba(8, 11, 12, 0.5), rgba(29, 25, 21, 0.84), rgba(8, 11, 12, 0.5));
+  font: 700 clamp(0.7rem, 0.82vw, 0.9rem)/1.2 system-ui, sans-serif;
+  letter-spacing: 0.11em;
+  text-transform: uppercase;
+}
+
+.tv-dedicated-battle-context span,
+.tv-dedicated-battle-context small {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.tv-dedicated-battle-context strong {
+  color: var(--ag-brass-bright);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: clamp(0.9rem, 1.15vw, 1.3rem);
+  text-align: center;
+}
+
+.tv-dedicated-battle-context small { text-align: right; }
+
+.tv-dedicated-battle-stage .tv-command-battle-instrument {
+  position: relative;
+  width: min(100%, 105rem);
+  height: 100%;
+  min-height: 0;
+  justify-self: center;
+  border: 1px solid var(--ag-rule-strong);
+  background: radial-gradient(circle at 50% 42%, rgba(168, 136, 82, 0.08), transparent 38%), var(--ag-iron-900);
+}
+
+.tv-dedicated-battle-stage .host-battle-overlay {
+  position: absolute;
+  inset: 0;
+  padding: clamp(0.25rem, 0.55vw, 0.65rem);
+}
+
+.tv-dedicated-battle-stage .host-battle-panel {
+  width: 100%;
+  height: 100%;
+  max-width: 104rem;
+}
+
+@media (max-width: 1300px), (max-height: 760px) {
+  .tv-dedicated-battle-stage { padding: 0.35rem; gap: 0.35rem; }
+  .tv-dedicated-battle-context { min-height: 2.15rem; padding-block: 0.25rem; }
+  .tv-dedicated-battle-stage .host-battle-overlay { padding: 0.25rem; }
+  .tv-dedicated-battle-stage .host-battle-combatant {
+    grid-template-rows: clamp(3.3rem, 8svh, 4.2rem) minmax(0, 1fr) clamp(7.2rem, 19svh, 8.5rem);
+  }
+  .tv-dedicated-battle-stage .host-battle-vs-block { padding-block: 0.35rem; gap: 0.2rem; }
+  .tv-dedicated-battle-stage .host-battle-vs-block > strong { font-size: clamp(2.25rem, 4.4vw, 3.8rem); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tv-dedicated-battle-stage {
+    animation-name: ag-instrument-enter;
+    clip-path: none;
+  }
+}
