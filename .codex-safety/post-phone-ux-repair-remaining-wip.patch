+.phone-card-inspect-trigger {
+  position: relative;
+  display: block;
+  width: 100%;
+  height: 100%;
+  min-width: 0;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: inherit;
+  cursor: zoom-in;
+}
+
+.phone-card-inspect-trigger > img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+
+.phone-card-inspect-trigger__hint {
+  position: absolute;
+  right: 0.35rem;
+  bottom: 0.35rem;
+  padding: 0.18rem 0.42rem;
+  border: 1px solid rgba(209, 174, 99, 0.5);
+  background: rgba(4, 8, 10, 0.82);
+  color: #f1d99d;
+  font-size: 0.62rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.phone-card-inspect {
+  position: fixed;
+  inset: 0;
+  z-index: 240;
+  display: grid;
+  place-items: center;
+  padding: max(0.75rem, env(safe-area-inset-top)) 0.75rem max(0.75rem, env(safe-area-inset-bottom));
+}
+
+.phone-card-inspect__backdrop {
+  position: absolute;
+  inset: 0;
+  border: 0;
+  background: rgba(0, 0, 0, 0.88);
+}
+
+.phone-card-inspect__panel {
+  position: relative;
+  z-index: 1;
+  display: grid;
+  grid-template-rows: auto minmax(0, 1fr) auto;
+  width: min(100%, 30rem);
+  max-height: calc(100dvh - 1.5rem - env(safe-area-inset-top) - env(safe-area-inset-bottom));
+  overflow: hidden;
+  border: 1px solid rgba(209, 174, 99, 0.55);
+  background: rgba(5, 9, 11, 0.98);
+  box-shadow: 0 1.2rem 4rem rgba(0, 0, 0, 0.75);
+}
+
+.phone-card-inspect__panel > header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0.75rem;
+  padding: 0.75rem;
+  border-bottom: 1px solid rgba(209, 174, 99, 0.25);
+}
+
+.phone-card-inspect__panel h2,
+.phone-card-inspect__panel header span,
+.phone-card-inspect__copy p {
+  margin: 0;
+}
+
+.phone-card-inspect__panel header span {
+  color: #b99a5e;
+  font-size: 0.68rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+.phone-card-inspect__panel h2 {
+  color: #f0e4c8;
+  font-size: 1.05rem;
+}
+
+.phone-card-inspect__close {
+  min-height: 2.75rem;
+  padding: 0.55rem 0.8rem;
+  border: 1px solid rgba(209, 174, 99, 0.55);
+  background: rgba(35, 25, 16, 0.86);
+  color: #f0e4c8;
+}
+
+.phone-card-inspect__art-frame {
+  min-height: 0;
+  padding: 0.65rem;
+  background: radial-gradient(circle at center, rgba(45, 60, 62, 0.35), rgba(0, 0, 0, 0.72));
+}
+
+.phone-card-inspect__art-frame img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+}
+
+.phone-card-inspect__copy {
