+.phone-movement-summary .combat-die-label {
+  color: rgba(4, 16, 23, 0.82);
+  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.46);
+}
+
+.phone-move-panel--resolving .phone-movement-empty {
+  min-height: 5rem;
+  border-style: solid;
+  border-color: rgba(90, 185, 225, 0.42);
+}
+
+@media (max-width: 1500px), (max-height: 850px) {
+  .tv-movement-focus {
+    grid-template-columns: minmax(11.5rem, 15rem) minmax(15rem, 22rem);
+    gap: 0.42rem 0.58rem;
+  }
+
+  .tv-movement-focus-heading,
+  .tv-movement-focus-roll,
+  .tv-movement-focus-destination,
+  .tv-movement-focus-travel,
+  .tv-movement-focus-timeline {
+    padding-block: 0.42rem;
+  }
+}
+
+/* Fresh-session QA: keep the map wrappers stretched when movement removes both side rails. */
+.tv-command-dashboard--movement-focus .tv-command-stage-movement-focus {
+  grid-template-columns: minmax(0, 1fr);
+  grid-template-rows: minmax(0, 1fr);
+}
+
+.tv-command-dashboard--movement-focus .tv-command-stage-movement-focus > .tv-command-map-shell,
+.tv-command-dashboard--movement-focus .tv-command-map-shell > .tv-board-panel,
+.tv-command-dashboard--movement-focus .tv-command-map-shell .tv-board-shell,
+.tv-command-dashboard--movement-focus .tv-command-map-shell .board-stage {
+  width: 100%;
+  height: 100%;
+  max-width: none;
+  max-height: none;
+  min-width: 0;
+  min-height: 0;
+}
+
+.tv-command-dashboard--movement-focus .tv-command-stage-movement-focus > .tv-command-map-shell {
+  grid-column: 1;
+  grid-row: 1;
+  justify-self: stretch;
+  align-self: stretch;
+}
+
+.tv-command-dashboard--movement-focus .tv-command-stage-movement-focus > .tv-movement-focus {
+  position: absolute;
+}
+
+.tv-command-dashboard--movement-focus .tv-command-map-shell .tv-board-shell {
+  display: block;
+}
+
+.tv-command-dashboard--movement-focus .tv-command-map-shell .board-stage {
+  aspect-ratio: auto;
+}
